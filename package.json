{
  "name": "league_proj_new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "test:gamification": "npx tsx scripts/test-gamification.ts",
    "test:onboarding": "npx tsx scripts/test-onboarding.ts",
    "test:video-reporting": "npx tsx scripts/test-video-reporting.ts",
    "test:levels": "npx tsx scripts/test-levels.ts",
    "test:timer": "npx tsx scripts/test-study-timer.ts",
    "test:study-concurrency": "node --env-file=.env.local --import tsx scripts/test-study-concurrency.ts",
    "test:economy-concurrency": "node --env-file=.env.local --import tsx scripts/test-economy-concurrency.ts",
    "test:distributed-lock": "node --env-file=.env.local --import tsx scripts/test-distributed-lock.ts",
    "test:sse-replicas": "DEV_LOAD_TEST_CONFIRM=1 node --env-file=.env.local --import tsx scripts/test-cross-replica-sse.ts",
    "test:invariants": "node --env-file=.env.local --import tsx scripts/check-invariants.ts",
    "test:stale-sessions": "node --env-file=.env.local --import tsx scripts/test-stale-study-sessions.ts",
    "maintenance:stale-sessions": "node --env-file=.env.local --import tsx scripts/settle-stale-study-sessions.ts",
    "test:load-balancer": "node --import tsx scripts/load-test-balancer.ts",
    "test:load:500": "DEV_LOAD_TEST_CONFIRM=1 node --env-file=.env.local --import tsx scripts/load-500.ts",
    "test:load:production-visible": "DEV_LOAD_TEST_CONFIRM=1 PRODUCTION_LOAD_TEST_CONFIRM=1 LOAD_VISIBLE_ACTIVITY=1 node --import tsx scripts/load-500.ts",
    "scenario:production": "PRODUCTION_SCENARIO_CONFIRM=1 node --import tsx scripts/seed-production-scenario.ts",
    "test:mission-rooms": "npx tsx scripts/test-mission-rooms.ts",
    "test:auth": "npx tsx scripts/test-auth.ts",
    "bot:bale": "npx tsx scripts/poll-bale.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.70.0",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "hls.js": "^1.6.16",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "next": "16.2.9",
    "pg": "^8.21.0",
    "posthog-js": "^1.418.10",
    "posthog-node": "^5.50.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
